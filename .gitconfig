[user]
	# Identity is machine-local: ~/.gitconfig carries user.name/user.email after
	# the [include], so each host keeps its own values and none land in tracked
	# content. useConfigOnly stays here so git refuses to guess an identity from
	# the environment instead of committing as user@host by accident.
	useConfigOnly = true
# core.hooksPath / core.attributesfile are intentionally not set here:
# ~/.git-hooks and ~/.attributes_global are machine-local and not deployed
# by setup.sh. Set them per machine if needed.
# core.ignorecase / core.filemode are left to git's per-repo auto-detection
# so the same config works on macOS and Linux/Synology.
[core]
	quotepath = false
	longpaths = true
	autocrlf = input
	trustctime = false
	excludesfile = ~/.gitignore_global
	untrackedcache = true
	pager = delta

# filter.lfs.required=true means a host without git-lfs fails on any repo with
# LFS attributes. setup.sh installs git-lfs via brew/apt; on Synology install it
# manually (`opkg install git-lfs`) before cloning LFS repos.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = master
[http]
	postBuffer = 655360000
	version = HTTP/1.1
[lfs]
	concurrenttransfers = 32
	fetchrecentrefsdays = 0
	pruneoffsetdays = 0
	dialtimeout = 3
	tlstimeout = 3
[lfs "transfer"]
	maxretries = 1
	maxretrydelay = 2
[push]
    #default = matching
	default = simple
	followTags = true
# receive.denyCurrentBranch is intentionally not set globally: it allows
# pushing into the checked-out branch of a non-bare repo and can clobber the
# working tree. Set it per-repo on NAS checkouts that need it.
[color]
	status = auto
	branch = auto
	diff = auto
	grep = auto
	interactive = auto
	ui = auto
[alias]
    prune = fetch --prune
    stash-all = stash save --include-untracked
[delta]
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula
