{
  "_comment": "CodeBuddy → agent state hooks, two channels per event, each self-gating. herdr-agent-state.sh reports to herdr (and skips itself under TUIOS_ENV=1); `tuios agent-hook claude-code` reads the hook payload on stdin and reports natively to the tuios pane (outside tuios it finds no pane and reports nothing; the guard keeps hosts without tuios quiet). Custom codebuddy hook (not herdr's official claude integration) so panes are labeled 'codebuddy' in herdr's sidebar. herdr lifecycle: SessionStart→idle, UserPromptSubmit/PreToolUse/PostToolUse→working, PermissionRequest→blocked, Stop→idle, SessionEnd→release. tuios lifecycle via payload events: SessionStart→idle+bind, UserPromptSubmit/PreToolUse/PostToolUse→working, PermissionRequest→needs_input(approval), Stop→done, SessionEnd→state cleared.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh idle", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh working", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh working", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh working", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh blocked", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh idle", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ~/.codebuddy/hooks/herdr-agent-state.sh release", "timeout": 10 },
          { "type": "command", "command": "command -v tuios >/dev/null 2>&1 && tuios agent-hook claude-code || :", "timeout": 10 }
        ]
      }
    ]
  }
}
