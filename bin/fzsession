#!/bin/bash
# fzsession — fuzzy-switch between multiplexer sessions
# Shows zellij + tmux + herdr + tuios sessions in a combined fzf picker.
set -euo pipefail

have_cmd() { command -v "$1" >/dev/null 2>&1; }

# Strip ANSI escape codes (color, style) from multiplexer session listings
strip_ansi() { sed $'s/\e\[[0-9;]*[a-zA-Z]//g'; }

sessions=""

if have_cmd zellij; then
    zlist=$(zellij list-sessions 2>/dev/null | strip_ansi || true)
    if [ -n "$zlist" ]; then
        sessions="${sessions}$(printf '%s\n' "$zlist" | sed 's/^/zellij: /')"$'\n'
    fi
fi

if have_cmd tmux; then
    tlist=$(tmux list-sessions 2>/dev/null | strip_ansi || true)
    if [ -n "$tlist" ]; then
        sessions="${sessions}$(printf '%s\n' "$tlist" | sed 's/^/tmux: /')"$'\n'
    fi
fi

if have_cmd herdr; then
    # herdr session list --json outputs structured JSON
    hjson=$(herdr session list --json 2>/dev/null || true)
    if [ -n "$hjson" ]; then
        hlist=$(printf '%s\n' "$hjson" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for s in data.get("sessions", []):
    name = s["name"]
    status = "running" if s.get("running") else "stopped"
    directory = s.get("session_dir", "")
    print(f"{name} [{status}] {directory}")
' 2>/dev/null || true)
        if [ -n "$hlist" ]; then
            sessions="${sessions}$(printf '%s\n' "$hlist" | sed 's/^/herdr: /')"$'\n'
        fi
    fi
fi

if have_cmd tuios; then
    # `tuios ls --json` prints saved sessions too and exits 3 when the daemon is
    # down; both cases still give usable rows, so ignore the status.
    tujson=$(tuios ls --json 2>/dev/null || true)
    if [ -n "$tujson" ]; then
        tulist=$(printf '%s\n' "$tujson" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for s in data:
    name = s.get("name", "?")
    nwins = s.get("window_count", 0)
    if s.get("saved"):
        state = "saved"
    elif s.get("attached"):
        state = "attached"
    else:
        state = "idle"
    print(f"{name} [{nwins}w {state}]")
' 2>/dev/null || true)
        if [ -n "$tulist" ]; then
            sessions="${sessions}$(printf '%s\n' "$tulist" | sed 's/^/tuios: /')"$'\n'
        fi
    fi
fi

# Trim trailing newline
sessions=${sessions%$'\n'}

if [ -z "$sessions" ]; then
    echo "fzsession: no multiplexer sessions found" >&2
    exit 1
fi

chosen=$(printf '%s\n' "$sessions" | fzf \
    --header="Sessions (zellij + tmux + herdr + tuios)" \
    --prompt="attach > " \
    --preview='
        ln={}
        prefix="${ln%%:*}"
        rest="${ln#*: }"
        if [ "$prefix" = "tmux" ]; then
            name="${rest%%:*}"
            tmux list-windows -t "$name" 2>/dev/null
        elif [ "$prefix" = "zellij" ]; then
            zellij list-sessions 2>/dev/null | grep -F "$rest" || echo "$rest"
        elif [ "$prefix" = "herdr" ]; then
            echo "$rest"
        elif [ "$prefix" = "tuios" ]; then
            name="${rest%% *}"
            tuios list-windows -s "$name" 2>/dev/null || echo "$rest"
        else
            echo "$ln"
        fi
    ' \
    --preview-window='right:50%' \
    2>/dev/null || true)
if [ -z "$chosen" ]; then
    # User cancelled fzf
    exit 0
fi

# Parse the prefix (zellij: / tmux: / herdr: / tuios:) and the remainder
prefix="${chosen%%:*}"
remainder="${chosen#*: }"

# ---------------------------------------------------------------------------
# Detect whether we are already inside a multiplexer. Attaching to a session of
# the *same* multiplexer from inside one of its panes nests a second client, so
# use the multiplexer's in-place switch instead. `tuios switch-session`,
# `zellij action switch-session` and `tmux switch-client` move the current
# client without spawning anything new.
#
# Order matters: the tuios daemon exports HERDR_ENV/HERDR_SOCKET_PATH to emulate
# herdr, so TUIOS_ENV must be checked before HERDR_ENV.
# ---------------------------------------------------------------------------
current_mux=""
if [ -n "${TUIOS_ENV:-}" ]; then
    current_mux=tuios
elif [ -n "${HERDR_ENV:-}" ]; then
    current_mux=herdr
elif [ -n "${ZELLIJ:-}" ] || [ -n "${ZELLIJ_SESSION_NAME:-}" ]; then
    current_mux=zellij
elif [ -n "${TMUX:-}" ]; then
    current_mux=tmux
fi

# Name of the session we are sitting in, used to no-op when the picked session
# is the one already on screen.
current_session=""
case "$current_mux" in
    tuios) current_session="${TUIOS_SESSION:-}" ;;
    zellij) current_session="${ZELLIJ_SESSION_NAME:-}" ;;
    tmux) current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true) ;;
esac

case "$prefix" in
    zellij)
        name=$(printf '%s\n' "$remainder" | awk '{print $1}')
        if [ "$current_mux" = "zellij" ]; then
            if [ "$name" = "$current_session" ]; then
                exit 0
            fi
            exec zellij action switch-session "$name"
        fi
        exec zellij attach "$name"
        ;;
    tmux)
        name=$(printf '%s\n' "$remainder" | awk -F: '{print $1}')
        if [ "$current_mux" = "tmux" ]; then
            if [ "$name" = "$current_session" ]; then
                exit 0
            fi
            exec tmux switch-client -t "$name"
        fi
        exec tmux attach-session -t "$name"
        ;;
    herdr)
        name=$(printf '%s\n' "$remainder" | awk '{print $1}')
        # herdr's CLI has no in-place session switch (only `session attach`), so
        # there is no way to avoid nesting from inside a herdr session.
        exec herdr session attach "$name"
        ;;
    tuios)
        name=$(printf '%s\n' "$remainder" | awk '{print $1}')
        if [ "$current_mux" = "tuios" ]; then
            if [ "$name" = "$current_session" ]; then
                exit 0
            fi
            exec tuios switch-session "$name"
        fi
        exec tuios attach "$name"
        ;;
    *)
        echo "fzsession: unknown session type '$prefix'" >&2
        exit 1
        ;;
esac
