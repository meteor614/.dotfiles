# Reasonix CodeGraph runtime — auto-generated per-machine, not portable
.codegraph/
.mimocode/
.reasonix/attachments/
.qoder/

# Local Claude Code settings (also in ~/.gitignore_global; keep here so a
# machine without the global ignore can't accidentally commit settings.local.json)
.claude/

# macOS Zellij cache — local state, not portable
Library/

# Stray npm lockfiles/manifests occasionally generated by tools in the
# dotfiles tree (e.g. npx/npm run in this directory).
package-lock.json
package.json
.config/nvim/lua/package-lock.json

# Yazi plugins — managed by `ya pack`, not tracked (upgrade with `ya pack -u`)
.config/yazi/plugins/
.config/yazi/package.toml

# Neovim server log — local debugging artifacts
nvim.log

# zsh tool-init cache — machine-specific PATH snapshots (stale venv leaks)
# (real cache lives at ~/.zsh_cache; this covers a stray copy in the repo)
.zsh_cache/

# Compiled zsh rc files. `zcompile` writes <file>.zwc next to its input, so
# `zcompile .config/shell/common.sh` (a relative path) drops the dump inside
# the repo even though the symlinked ~/.config copy lands in $HOME.
*.zwc

# Machine-local secrets sourced from common.sh (`[ -f ~/.api_key_env ] && . …`).
# The file is expected to live outside the repo, but a stray copy must never be
# committed — it holds provider API keys in plain text.
.api_key_env

