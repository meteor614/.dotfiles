# ~/.zshrc.local — local overrides on top of ~/.zshrc + common.sh.
# Shared logic (aliases, TERM, NVM, Homebrew mirror, WezTerm/Ghostty mux var)
# now lives in ~/.config/shell/common.sh and is sourced from ~/.zshrc.

# ── Keymaps (zsh-only) ───────────────────────────────────────────────────────
bindkey -s '\ee' 'vim\n'
bindkey '\eh' backward-char
bindkey '\el' forward-char
bindkey '\ej' down-line-or-history
bindkey '\ek' up-line-or-history
# bindkey '\eu' undo
bindkey '\eH' backward-word
bindkey '\eL' forward-word
bindkey '\eJ' beginning-of-line
bindkey '\eK' end-of-line

bindkey -s '\eo' 'cd ..\n'
bindkey -s '\e;' 'll\n'

bindkey '\e[1;3D' backward-word       # ALT+左键：向后跳一个单词
bindkey '\e[1;3C' forward-word        # ALT+右键：前跳一个单词
bindkey '\e[1;3A' beginning-of-line   # ALT+上键：跳到行首
bindkey '\e[1;3B' end-of-line         # ALT+下键：调到行尾
(( $+commands[deer] )) && bindkey '\ev' deer

# fzsession: switch multiplexer sessions via fzf (Alt+Z)
(( $+commands[fzf] )) && bindkey -s '\ez' 'fzsession\n'

# ── zsh options ──────────────────────────────────────────────────────────────
setopt no_nomatch
setopt no_beep
# Disable inter-session history sharing — atuin handles cross-session history
# via its own sync, and share_history causes duplicate entries between tmux
# panes and multiple terminal windows.
# Only share_history is dropped: it is the option that re-reads $HISTFILE into
# every pane (the duplicate source). inc_append_history is kept on — it just
# appends each command to $HISTFILE instead of waiting for a clean exit, which
# is what keeps history (and therefore zsh-autosuggestions) alive when a pane
# is killed by tuios/herdr.
unsetopt share_history

# ── kubectl completion ───────────────────────────────────────────────────────
# The lazy `kubectl completion zsh` wrapper that lived here was removed: carapace
# (.zshrc) registers its own kubectl completer, which covers resources/contexts/
# namespaces and needs no ~/.cache/dotfiles/kubectl.zsh cache.

# ── Autostart multiplexer on incoming SSH ────────────────────────────────────
# tuios > zellij > tmux. tuios 缺失时回退到原有的 zellij/tmux 逻辑。
if [[ -z "${DOTFILES_NONINTERACTIVE:-}" \
      && -o login \
      && -n "$SSH_CONNECTION" \
      && -z "${SSH_ORIGINAL_COMMAND:-}" \
      && -z "$TMUX" \
      && -z "$ZELLIJ" \
      && -z "${TUIOS_ENV:-}" \
      && -t 0 \
      && $# -eq 0 \
      && -z "${ZSH_EXECUTION_STRING:-}" ]]; then
    if (( $+commands[tuios] )); then
        exec tuios attach
    elif (( $+commands[zellij] )); then
        exec zellij a -c work
    elif (( $+commands[tmux] )); then
        exec tmux new -As default-0
    fi
fi

# ── OpenClaw Completion ──────────────────────────────────────────────────────
[ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"
