# noctty config — managed by this dotfiles repo.
#
# noctty (https://github.com/amanthanvi/noctty) is a native Windows terminal
# built on Ghostty's core. It reads its config from
#     %LOCALAPPDATA%\noctty\config.ghostty
# which lives outside $HOME, so the generic .config/* linking in setup.sh
# cannot reach it. setup.sh copies this file to that path instead (from WSL
# via cmd.exe/wslpath, or natively under Git Bash via %LOCALAPPDATA%) and
# keeps a one-time backup as config.ghostty.dotfiles.bak.
#
# Edit here, then re-run `setup.sh` (init or repair) to deploy.
# noctty can also reload in place with Ctrl+Shift+, (reload_config).

# ----- Font -----
# Hack Nerd Font has no ligature features at all (no liga/calt); -calt also
# disables contextual alternates for the Sarasa fallback. Mirrors
# .config/ghostty/config, except noctty uses 11pt.
font-family = Hack Nerd Font
font-family = Sarasa Mono SC
font-size = 11
font-feature = -calt

# ----- Shell -----
# Start every new tab/split straight into WSL instead of the detected
# PowerShell/cmd. noctty never picks WSL implicitly (wsl.exe --status can look
# healthy while launching a session fails), so the default shell has to be
# pinned explicitly. The profile picker (Ctrl+Shift+P) still lists PowerShell,
# cmd and Git Bash, and its own default check mark does not move with this.
#
# `direct:` launches wsl.exe without the `cmd.exe /C` wrapper a plain value
# goes through, and noctty passes the pane's directory as `wsl.exe --cd`
# (a Windows home maps to `~`, so a fresh window opens in $HOME).
# Pin a specific distribution with `direct:wsl.exe -d <distro>` if needed.
#
# Only read at process start: after changing this, quit noctty completely and
# start it again (reload_config does not re-apply `command` to new tabs), and
# test with a NEW tab — restored session tabs keep their saved profile.
command = direct:wsl.exe
